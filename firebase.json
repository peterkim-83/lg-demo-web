{
  "hosting": [
    {
      "target": "peter-demo-web",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "/agent-playground",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store"
            }
          ]
        },
        {
          "source": "/agent-playground/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store"
            }
          ]
        },
        {
          "source": "/firebase-auth-client.mjs",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store"
            }
          ]
        }
      ]
    },
    {
      "target": "voice-poc",
      "public": "voice-poc-public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ]
}
